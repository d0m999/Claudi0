# gstack local tool artifacts (browse logs, session state) — not project source
.gstack/

# macOS
.DS_Store

# Local-only environment file; never commit credentials
/.env

# Xcode / Swift (for when helper/ and gui/ land)
.build/
DerivedData/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/

# Local dev app bundle — ad-hoc signed, rebuilt on demand, never committed
dist/

# Personal/IP-protected sound packs (e.g. game character cries) — never commit or distribute
local-packs/

# Version only the default Factory Pack; keep other curated packs local.
/packs/*
!/packs/minimal-chime/
!/packs/README.md
!/packs/LICENSES.md
!/packs/bundled-pack-selection.json
!/packs/license-snapshots/

# Workflow 用的临时 worktree（Agent isolation: worktree）
.claude/worktrees/

# Local research documents — keep on this machine, never commit
docs/research/
docs/*research*.md

# Python bytecode cache (generated by scripts/*.py pack tooling)
__pycache__/

# Unused local license research for a pack that is not part of the current candidates
/packs/license-snapshots/kenney-impact-sounds-2026-09-02.html
/packs/license-snapshots/kenney-impact-sounds-2026-09-02.png
/packs/license-snapshots/kenney-impact-sounds-package-License-2026-09-02.txt

# WorkBuddy host-local state — never commit
.workbuddy/

# Local web prototype app registration
/.wbapp_*.genie

# macOS 截图落在仓库根，永远不进 Git
/截屏*.png

# Local animation distribution / comparison outputs; canonical assets and previewFiles stay tracked
/designs/pixel-motion/samples/claudi0-pixel-motion-samples.zip
/designs/pixel-motion/samples/G-compare-idle.gif
/designs/pixel-motion/samples/H-compare-stop.gif

# Local promo video project and production files
/claudi0-promo.miora
/claudi0-promo_assets/
/output/promo-video/

# Local sound redesign drafts and verification artifacts
/work/sounds-interaction-interview/
/work/sounds-native-implementation/

# Local Paseo worktree setup
/paseo.json
